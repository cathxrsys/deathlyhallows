screen.LIGHTING=Iluminaci\u00f3n y hora del d\u00eda
screen.LIGHTING.comment=Color del nombre = coste: \u00a7averde\u00a7r - gratis, \u00a7eamarillo\u00a7r - algo de FPS, \u00a7crojo\u00a7r - pesado
option.NIGHT_BRIGHTNESS=\u00a7aBrillo nocturno
