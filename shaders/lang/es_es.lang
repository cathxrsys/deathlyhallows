screen.DIMENSIONS=Nether y End
screen.DIMENSIONS.comment=Color del nombre = coste: \u00a7averde\u00a7r - gratis, \u00a7eamarillo\u00a7r - algo de FPS, \u00a7crojo\u00a7r - pesado
