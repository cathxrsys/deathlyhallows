screen.WEATHER=Clima y nieve
screen.WEATHER.comment=Color del nombre = coste: \u00a7averde\u00a7r - gratis, \u00a7eamarillo\u00a7r - algo de FPS, \u00a7crojo\u00a7r - pesado
option.RAIN_FOG=\u00a7aNiebla de lluvia
