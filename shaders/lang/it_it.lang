screen.DIMENSIONS=Nether e End
screen.DIMENSIONS.comment=Colore del nome = costo: \u00a7averde\u00a7r - gratis, \u00a7egiallo\u00a7r - un po' di FPS, \u00a7crosso\u00a7r - pesante
option.NETHER_BRIGHTNESS=\u00a7aLuminosit\u00e0 del Nether
