option.GRAIN_CONTRAST=\u00a7aKornkontrast
option.GRAIN_CONTRAST.comment=Niedrig = weiches schwaches Kr\u00e4useln, hoch = harte deutliche K\u00f6rnchen
option.GRAIN_SIZE=\u00a7aKorngr\u00f6\u00dfe
